pipeline{
    agent any
    
    stages{
        stage('build-system details'){
            steps{
                sh '''
                echo "system details"
                uname -a
                '''
            }
        }
        stage('memory details'){
            steps{
                sh '''
                echo "memory details"
                free -h
                '''
            }
        }
        stage('cpu details'){
            steps{
                sh '''
                echo "cpu details"
                lscpu
                '''
            }
        }
        stage('date'){
            steps{
                sh '''
                echo "today"
                date
                '''
            }
        }
    }
}
